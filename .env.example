# ANX RaspTank sidecar — copy to .env via ./prepare.sh (do not commit secrets).
# Joins the same stack as anx-public-examples/asset-node-ipc-docker (external network + MQTT oem).

# Image is built locally by ./up.sh (docker compose). No registry.

# --- IPC join (must match asset-node-ipc-docker) ---
IPC_DOCKER_NETWORK=anx-assets-ipc-network
IPC_MQTT_CERTS_DIR=../asset-node-ipc-docker/data/mqtt/certs

ROBOT_HTTP_PORT=5000
ROBOT_CONTROL_PASSWORD=

# Bridge (MQTT controller / telemetry). ./up.sh turns this on.
ANX_BRIDGE_ENABLED=true
ANX_CONTROL_SOURCE=auto
ANX_DEADMAN_MS=500
ANX_NODE_HEARTBEAT_MS=2000
ANX_OBSTACLE_STOP_MM=100
# Open-loop odometry (overlay only; calibrate on the bench)
# ANX_WHEEL_DIAMETER_M=0.045
# ANX_TRACK_WIDTH_M=0.12
# ANX_SPEED_AT_FULL_PWM_MPS=0.35
ANX_TOPIC_PREFIX=rasptank

# Same Mosquitto user/password as ipc-docker profile oem (prepare.sh can copy MQTT_PASSWORD)
MQTT_BROKER=mqtts://mqtt:8883
MQTT_USER=anx
MQTT_PASSWORD=
MQTT_CA_FILE=/certs/ca.crt

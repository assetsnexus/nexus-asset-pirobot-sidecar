# ANX RaspTank sidecar — copy to .env via ./prepare.sh (do not commit secrets).
# Joins the same stack as anx-public-examples/asset-node-ipc-docker (host MQTT TLS port).

# Image is built locally by ./up.sh (docker compose). No registry.

# --- IPC join (MQTT via host-published TLS port; sidecar uses network_mode: host) ---
IPC_MQTT_CERTS_DIR=../nexus-asset-example-docker-dev/data/mqtt/certs
MQTT_TLS_PORT=28883

ROBOT_HTTP_PORT=5000
ROBOT_WS_PORT=8888
ROBOT_CONTROL_PASSWORD=

# Self-signed HTTPS/WSS for the Adeept UI (generated by ./up.sh into data/certs/).
ANX_ROBOT_TLS=true
ANX_ROBOT_TLS_CERT=/certs/tls/robot.crt
ANX_ROBOT_TLS_KEY=/certs/tls/robot.key
ROBOT_TLS_DIR=./data/certs

# Bridge (MQTT controller / telemetry). ./up.sh turns this on.
ANX_BRIDGE_ENABLED=true
ANX_CONTROL_SOURCE=auto
ANX_DEADMAN_MS=500
# Status LEDs: red blink = control socket disconnected; blue blink = connected.
# Explicit police/breath commands override until idle; disconnected+idle → red.
ANX_IDLE_POLICE=true
ANX_IDLE_POLICE_MS=3000
ANX_NODE_HEARTBEAT_MS=2000
ANX_OBSTACLE_STOP_MM=100
# Open-loop odometry (overlay only; calibrate on the bench)
# ANX_WHEEL_DIAMETER_M=0.045
# ANX_TRACK_WIDTH_M=0.12
# ANX_SPEED_AT_FULL_PWM_MPS=0.35
ANX_TOPIC_PREFIX=rasptank

# Shoulder rest angle is NOT applied on connect (holding endstops overheats).
# Used only if something explicitly parks. Safe band for this horn is ~20–85°.
ANX_ARM_REST_DEG=45

# Same Mosquitto user/password as ipc-docker profile oem (prepare.sh can copy MQTT_PASSWORD)
# Host network → broker on 127.0.0.1:MQTT_TLS_PORT (ipc publishes 28883→8883 by default).
MQTT_BROKER=mqtts://127.0.0.1:28883
MQTT_USER=anx
MQTT_PASSWORD=
MQTT_CA_FILE=/certs/ca.crt

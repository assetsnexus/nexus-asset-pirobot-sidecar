# Overlay seed for robot_control/adeept_rasptank2/web/.env (gitignored).
# Copied by ./prepare.sh — do not edit the vendor submodule .env.example.
# Required for the web UI and WebSocket control.
ROBOT_CONTROL_PASSWORD=change-me

# Optional: stable session cookies across restarts. If unset, a key is derived from the password.
# FLASK_SECRET_KEY=

# --- Join asset-node-ipc-docker (same Docker network + Mosquitto oem profile) ---
# Set true after ipc ./prepare.sh + docker compose up (oem) so ca.crt + MQTT_PASSWORD exist.
ANX_BRIDGE_ENABLED=false
ANX_CONTROL_SOURCE=auto
ANX_DEADMAN_MS=500
ANX_TOPIC_PREFIX=rasptank

# MQTT — match ipc-docker prepare.sh / oem profile (user anx, TLS 8883)
MQTT_BROKER=mqtts://mqtt:8883
MQTT_USER=anx
MQTT_PASSWORD=
MQTT_CA_FILE=/certs/ca.crt
